#!/usr/bin/env bash

# @name zip
# @desc Select files/directories and create a zip archive

set -euo pipefail

die() {
  echo "tbx zip: $*" >&2
  exit 1
}

command -v zip >/dev/null 2>&1 || die "zip not found"
command -v fzf >/dev/null 2>&1 || die "fzf not found"

inputs=()

if [[ $# -gt 0 ]]; then
  inputs=("$@")
else
  current_dir="."
  action_file="$(mktemp "${TMPDIR:-/tmp}/tbx-zip-action.XXXXXX")"
  trap 'rm -f "$action_file"' EXIT

  while :; do
    : > "$action_file"
    inputs=()
    separator=$'\t'
    enter_binding="enter:transform:if [[ \${FZF_SELECT_COUNT:-0} -gt 0 ]]; then echo accept; else current_item=\"\${FZF_CURRENT_ITEM#*${separator}}\"; if [[ -d \"\$current_item\" ]]; then printf '%s\\0' \"\$current_item\" > '$action_file'; echo abort; else echo accept; fi; fi"

    while IFS= read -r -d '' item; do
      inputs+=("$item")
    done < <(
      {
        if [[ "$current_dir" != "." ]]; then
          parent_dir="$(dirname "$current_dir")"
          printf '%s%s%s\0' '[DIR] ..' "$separator" "$parent_dir"
        fi

        while IFS= read -r -d '' item; do
          if [[ -d "$item" ]]; then
            label="[DIR]  $(basename "$item")"
          else
            label="[FILE] $(basename "$item")"
          fi

          printf '%s%s%s\0' "$label" "$separator" "$item"
        done < <(find "$current_dir" -maxdepth 1 -mindepth 1 -print0)
      } |
        fzf \
          --read0 \
          --print0 \
          --multi \
          --delimiter="$separator" \
          --with-nth=1 \
          --accept-nth=2 \
          --prompt="zip [$current_dir] > " \
          --header='↑/↓ move   SPACE select   ENTER open/confirm   ESC cancel' \
          --bind='space:toggle' \
          --bind="$enter_binding" \
          --height=60% \
          --layout=reverse \
          --border
    )

    next_dir=""
    if IFS= read -r -d '' next_dir < "$action_file"; then
      current_dir="$next_dir"
      continue
    fi

    break
  done
fi

[[ ${#inputs[@]} -gt 0 ]] || exit 0

# Default output name
if [[ ${#inputs[@]} -eq 1 ]]; then
  input="${inputs[0]%/}"
  default_output="$(basename "$input").zip"
else
  default_output="archive-$(date '+%Y%m%d-%H%M%S').zip"
fi

read -r -p "Output name [$default_output]: " output

# Empty input → use default
if [[ -z "$output" ]]; then
  output="$default_output"
fi

# Automatically append .zip
if [[ "$output" != *.zip ]]; then
  output="${output}.zip"
fi

while [[ -e "$output" ]]; do
  [[ -f "$output" ]] || die "$output exists and is not a regular file"

  read -r -p "$output already exists. Press Enter to overwrite, or enter a new name: " replacement

  if [[ -z "$replacement" ]]; then
    rm -f -- "$output"
    break
  fi

  output="$replacement"

  if [[ "$output" != *.zip ]]; then
    output="${output}.zip"
  fi
done

zip -r "$output" "${inputs[@]}" -x '*/.env' -x '*/tests/*' -x '*/node_modules/*' -x '*/dist/*' -x '*/.git/*' -x '*/.credential/*' -x '*/.state/*' -x '*/err_logs/*' -x '*/.venv/*'

echo "Created: $output"
